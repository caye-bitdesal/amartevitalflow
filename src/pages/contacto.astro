---
import BaseLayout from "../layouts/BaseLayout.astro";
import { contact, founder } from "../data/site";
---

<BaseLayout title="Contacto" description="Contacta con Am'Arte Vital Flow para reservar una sesión o resolver tus dudas.">
  <!-- Founder -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="grid lg:grid-cols-5 gap-12 lg:gap-16 items-start">
        <div class="lg:col-span-2">
          <div class="aspect-[3/4] rounded-[3rem] overflow-hidden bg-gradient-to-br from-sage/25 to-mustard/15">
            <img
              src="/contacto-alize.png"
              alt={`${founder.name} practicando movimiento consciente`}
              class="h-full w-full object-cover object-center"
              loading="eager"
            />
          </div>
        </div>
        <div class="lg:col-span-3">
          <h1 class="font-serif text-3xl lg:text-4xl text-brown mb-6">{founder.title}</h1>
          <p class="font-serif text-2xl text-brown mb-1">{founder.name}</p>
          <p class="text-terracotta italic mb-1">{founder.role}</p>
          <p class="text-sage text-sm tracking-wide mb-8">{founder.credentials}</p>
          {
            founder.paragraphs.map((p, i) => (
              <p
                class:list={[
                  "leading-relaxed mb-4",
                  i === founder.paragraphs.length - 1
                    ? "font-medium text-brown text-lg mt-6"
                    : "text-brown/75",
                ]}
              >
                {p}
              </p>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-24 bg-cream-dark/20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16">
        <div>
          <h2 class="font-serif text-3xl lg:text-4xl text-brown mb-6">Contacto</h2>
          <p class="text-brown/75 leading-relaxed mb-10">
            Si quieres reservar una sesión, preguntar sobre un taller o simplemente saber más sobre
            cómo puedo acompañarte, escríbeme. Responderé lo antes posible.
          </p>

          <ul class="space-y-6 mb-10">
            <li>
              <p class="text-sm text-brown/50 mb-1">Email</p>
              <a href={`mailto:${contact.email}`} class="text-brown hover:text-terracotta transition-colors">
                {contact.email}
              </a>
            </li>
            <li>
              <p class="text-sm text-brown/50 mb-1">Teléfono</p>
              <a href={`tel:${contact.phone.replace(/\s/g, "")}`} class="text-brown hover:text-terracotta transition-colors">
                {contact.phone}
              </a>
            </li>
            <li>
              <p class="text-sm text-brown/50 mb-1">Ubicación</p>
              <p class="text-brown">{contact.location}</p>
            </li>
          </ul>

          <a
            id="whatsapp-link"
            href={`https://wa.me/${contact.whatsapp}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#25D366] text-white text-sm font-medium hover:opacity-90 transition-opacity"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
            </svg>
            Escríbeme por WhatsApp
          </a>
        </div>

        <form class="bg-white rounded-3xl p-8 shadow-sm border border-cream-dark/50 space-y-6" action="#" method="POST">
          <div>
            <label for="name" class="block text-sm text-brown/70 mb-2">Nombre</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full px-4 py-3 rounded-xl border border-cream-dark bg-cream/50 text-brown focus:outline-none focus:ring-2 focus:ring-sage/40"
            />
          </div>
          <div>
            <label for="email" class="block text-sm text-brown/70 mb-2">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full px-4 py-3 rounded-xl border border-cream-dark bg-cream/50 text-brown focus:outline-none focus:ring-2 focus:ring-sage/40"
            />
          </div>
          <div>
            <label for="service" class="block text-sm text-brown/70 mb-2">Servicio de interés</label>
            <select
              id="service"
              name="service"
              class="w-full px-4 py-3 rounded-xl border border-cream-dark bg-cream/50 text-brown focus:outline-none focus:ring-2 focus:ring-sage/40"
            >
              <option value="">Selecciona una opción</option>
              <option value="naturopatia">Consulta de Naturopatía</option>
              <option value="movimiento">Movimiento Flow</option>
              <option value="talleres">Talleres y eventos</option>
              <option value="otro">Otro</option>
            </select>
          </div>
          <div>
            <label for="message" class="block text-sm text-brown/70 mb-2">Mensaje</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              class="w-full px-4 py-3 rounded-xl border border-cream-dark bg-cream/50 text-brown focus:outline-none focus:ring-2 focus:ring-sage/40 resize-none"
            ></textarea>
          </div>
          <button
            type="submit"
            class="w-full py-3.5 rounded-full bg-terracotta text-cream font-medium tracking-wide hover:bg-terracotta/90 transition-colors"
          >
            Enviar mensaje
          </button>
          <p class="text-xs text-brown/50 text-center">
            El formulario es provisional. Conectaremos el envío en una fase posterior.
          </p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ whatsappNumber: contact.whatsapp }}>
  const params = new URLSearchParams(window.location.search);
  const servicio = params.get("servicio");
  const mensaje = params.get("mensaje");

  if (servicio) {
    const serviceSelect = document.getElementById("service");
    if (serviceSelect instanceof HTMLSelectElement) {
      serviceSelect.value = servicio;
    }
  }

  if (mensaje) {
    const messageField = document.getElementById("message");
    if (messageField instanceof HTMLTextAreaElement) {
      messageField.value = mensaje;
    }

    const whatsappLink = document.getElementById("whatsapp-link");
    if (whatsappLink instanceof HTMLAnchorElement) {
      whatsappLink.href = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(mensaje)}`;
    }

    whatsappLink?.scrollIntoView({ behavior: "smooth", block: "center" });
  }
</script>
