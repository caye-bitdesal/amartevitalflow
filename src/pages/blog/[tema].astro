---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogTopics from "../../components/BlogTopics.astro";
import { blog } from "../../data/site";

export function getStaticPaths() {
  return blog.topics.map((topic) => ({
    params: { tema: topic.slug },
    props: { topic },
  }));
}

const { topic } = Astro.props;
const articles = blog.articles.filter((article) => article.topic === topic.slug);
---

<BaseLayout
  title={`${topic.title} | Blog`}
  description={`Artículos sobre ${topic.title.toLowerCase()} en el blog de Am'Arte Vital Flow.`}
>
  <section class="py-10 lg:py-24">
    <div class="mx-auto max-w-3xl px-6">
      <h1 class="mb-6 flex items-center justify-center gap-3 sm:gap-4 text-center font-serif text-3xl sm:text-4xl lg:text-5xl text-brown">
        <span
          class="hidden h-px w-16 shrink-0 bg-gradient-to-r from-transparent via-brown/50 to-transparent sm:block sm:w-24"
          aria-hidden="true"
        ></span>
        <span>{blog.title}</span>
        <span
          class="hidden h-px w-16 shrink-0 bg-gradient-to-r from-transparent via-brown/50 to-transparent sm:block sm:w-24"
          aria-hidden="true"
        ></span>
      </h1>
      <p class="text-lg text-brown/75 leading-relaxed mb-10 text-center">{blog.intro}</p>

      <BlogTopics current={topic.slug} />

      {
        articles.length > 0 ? (
          <div class="space-y-8">
            {articles.map((article) => (
              <article class="border-b border-brown/15 pb-8 last:border-b-0">
                <h2 class="font-serif text-2xl text-brown mb-3">
                  <a href={article.href} class="hover:text-terracotta transition-colors">
                    {article.title}
                  </a>
                </h2>
                <p class="text-brown/75 leading-relaxed">{article.excerpt}</p>
              </article>
            ))}
          </div>
        ) : (
          <p class="text-brown/60 leading-relaxed text-center">
            Pronto iré publicando artículos sobre {topic.title.toLowerCase()}.
          </p>
        )
      }
    </div>
  </section>
</BaseLayout>
