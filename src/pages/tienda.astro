---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Tienda">
  <section class="py-24 lg:py-32">
    <div class="mx-auto max-w-2xl px-4 sm:px-6 text-center">
      <p class="text-xs font-medium tracking-[0.2em] text-terracotta mb-4">PRÓXIMAMENTE</p>
      <h1 class="font-serif text-4xl lg:text-5xl text-brown mb-6">Tienda</h1>
      <p class="text-brown/75 leading-relaxed mb-10">
        Estamos preparando una selección de productos naturales y recursos para tu bienestar.
        Muy pronto podrás descubrirlos aquí.
      </p>
      <a
        href="/contacto"
        class="inline-flex items-center px-6 py-3 rounded-full bg-sage text-cream text-sm tracking-wide hover:bg-sage/90 transition-colors"
      >
        Avísame cuando esté disponible
      </a>
    </div>
  </section>
</BaseLayout>
