---
import BaseLayout from "../layouts/BaseLayout.astro";
import ImageHeroCarousel from "../components/ImageHeroCarousel.astro";
import { servicePages } from "../data/site";

const page = servicePages.naturopatia;
---

<BaseLayout title={page.title} description={[...page.intro, ...page.introContinued].join(" ")}>
  <ImageHeroCarousel eyebrow={page.eyebrow} images={page.headerImages} />

  <section class="py-10 lg:py-24">
    <div class="mx-auto max-w-6xl px-6">
      <div class="max-w-3xl space-y-4 mb-16 lg:mb-20">
        {
          page.intro.map((paragraph) => (
            <p class="text-lg text-brown/80 leading-snug text-justify italic">{paragraph}</p>
          ))
        }
        <p class="font-serif text-3xl lg:text-4xl font-bold text-brown leading-tight text-right ml-2 sm:ml-4 lg:ml-6">
          {page.introHighlight}
        </p>
        {
          page.introContinued.map((paragraph) => (
            <p class="text-lg text-brown/80 leading-snug text-justify italic">{paragraph}</p>
          ))
        }
      </div>
    </div>
  </section>

  {
    page.offerings.map((offering, index) => {
      const hasBand = index === 0 || index === 2;
      return (
        <section class:list={["py-10 lg:py-20", hasBand && "bg-cream-dark/60"]}>
          <div class="mx-auto max-w-6xl px-6">
            <article
              class:list={[
                "grid lg:grid-cols-2 gap-10 lg:gap-16",
                index === 2 ? "items-start" : "items-center",
                index % 2 === 1 && "lg:[&>*:first-child]:order-2",
              ]}
            >
              <div class="aspect-[4/3] rounded-[2rem] overflow-hidden bg-gradient-to-br from-sage/25 to-mustard/15">
                {
                  offering.image ? (
                    <img
                      src={offering.image}
                      alt={offering.imageAlt}
                      class="h-full w-full object-cover"
                      loading={index === 0 ? "eager" : "lazy"}
                    />
                  ) : (
                    <div class="flex h-full w-full items-center justify-center p-8 text-center">
                      <p class="text-sm text-brown/40">Imagen próximamente</p>
                    </div>
                  )
                }
              </div>

              <div>
                <h2 class="font-serif text-3xl lg:text-4xl text-brown mb-6">{offering.title}</h2>
                <div class="space-y-4">
                  {
                    offering.paragraphs.map((paragraph) => (
                      <p class="text-brown/75 leading-relaxed text-justify">{paragraph}</p>
                    ))
                  }
                </div>

                {
                  "sessionIntro" in offering && offering.sessionIntro && (
                    <div class="mt-8 space-y-2">
                      <p class="text-lg text-brown leading-snug text-justify">
                        {offering.sessionIntro.lead}
                      </p>
                      <p class="font-serif text-xl lg:text-2xl font-bold text-brown leading-snug text-center">
                        {offering.sessionIntro.statement}
                      </p>
                    </div>
                  )
                }

                {
                  "faq" in offering && offering.faq && (
                    <details class="mt-8 group">
                      <summary class="cursor-pointer list-none font-semibold text-brown hover:text-terracotta transition-colors [&::-webkit-details-marker]:hidden">
                        <span class="inline-flex items-center gap-2">
                          {offering.faq.question}
                          <svg
                            class="h-4 w-4 shrink-0 transition-transform group-open:rotate-180"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                          >
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                          </svg>
                        </span>
                      </summary>
                      <div class="mt-4 space-y-4">
                        {(Array.isArray(offering.faq.answer)
                          ? offering.faq.answer
                          : [offering.faq.answer]
                        ).map((paragraph) => (
                          <p class="text-brown/75 leading-relaxed pl-0 text-justify">{paragraph}</p>
                        ))}
                      </div>
                    </details>
                  )
                }

                {
                  "massageTypes" in offering && offering.massageTypes && (
                    <details class="mt-8 group">
                      <summary class="cursor-pointer list-none font-semibold text-brown hover:text-terracotta transition-colors [&::-webkit-details-marker]:hidden">
                        <span class="inline-flex items-center gap-2">
                          {offering.massageTypes.question}
                          <svg
                            class="h-4 w-4 shrink-0 transition-transform group-open:rotate-180"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                          >
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                          </svg>
                        </span>
                      </summary>
                      <div class="mt-4 space-y-6 rounded-xl border border-brown p-4 sm:p-5">
                        {offering.massageTypes.items.map((item) => (
                          <div>
                            <h3 class="font-semibold text-brown mb-2">{item.title}</h3>
                            {"body" in item && item.body && (
                              <p class="text-brown/75 leading-relaxed text-justify">{item.body}</p>
                            )}
                            {"note" in item && item.note && (
                              <p class="mt-1 text-sm text-brown/75 leading-relaxed text-justify italic">
                                {"noteHighlight" in item && item.noteHighlight
                                  ? (() => {
                                      const highlight = item.noteHighlight;
                                      const index = item.note.indexOf(highlight.text);
                                      if (index < 0) return item.note;
                                      return (
                                        <>
                                          {item.note.slice(0, index)}
                                          <a
                                            href={highlight.href}
                                            class="font-semibold text-inherit no-underline hover:text-terracotta transition-colors"
                                          >
                                            {highlight.text}
                                          </a>
                                          {item.note.slice(index + highlight.text.length)}
                                        </>
                                      );
                                    })()
                                  : item.note}
                              </p>
                            )}
                            {("duration" in item && item.duration) || ("price" in item && item.price) ? (
                              <div class="mt-3 leading-tight">
                                {"duration" in item && item.duration && (
                                  <p class="text-terracotta">{item.duration}</p>
                                )}
                                {"price" in item && item.price && (
                                  <p class="text-terracotta">{item.price}</p>
                                )}
                              </div>
                            ) : null}
                          </div>
                        ))}
                      </div>
                    </details>
                  )
                }

                {
                  "massageLocations" in offering && offering.massageLocations && (
                    <details class="mt-4 group">
                      <summary class="cursor-pointer list-none font-semibold text-brown hover:text-terracotta transition-colors [&::-webkit-details-marker]:hidden">
                        <span class="inline-flex items-center gap-2">
                          {offering.massageLocations.question}
                          <svg
                            class="h-4 w-4 shrink-0 transition-transform group-open:rotate-180"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                          >
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                          </svg>
                        </span>
                      </summary>
                      <div class="mt-4 space-y-6">
                        {offering.massageLocations.items.map((item) => (
                          <div>
                            <h3 class="flex items-start gap-2 font-semibold text-brown mb-2">
                              <svg
                                class="mt-0.5 h-5 w-5 shrink-0 text-terracotta"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                aria-hidden="true"
                              >
                                <path
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="1.75"
                                  d="M12 21s7-5.33 7-11a7 7 0 10-14 0c0 5.67 7 11 7 11z"
                                />
                                <circle cx="12" cy="10" r="2.25" stroke-width="1.75" />
                              </svg>
                              <span>{item.title}</span>
                            </h3>
                            {item.body && (
                              <p class="text-brown/75 leading-relaxed text-justify pl-7">{item.body}</p>
                            )}
                          </div>
                        ))}
                      </div>
                    </details>
                  )
                }

                <div class="mt-8">
                  <a
                    href={`/contacto?servicio=${encodeURIComponent(offering.contactService)}&mensaje=${encodeURIComponent(offering.contactMessage)}`}
                    class="inline-flex items-center px-6 py-3 rounded-full bg-terracotta text-cream text-sm tracking-wide hover:bg-terracotta/90 transition-colors"
                  >
                    Reservar cita
                  </a>
                </div>
              </div>
            </article>
          </div>
        </section>
      );
    })
  }

  <section class="py-10 lg:py-24">
    <div class="mx-auto max-w-6xl px-6">
      <div class="p-8 rounded-3xl bg-cream-dark/50 text-center">
        <p class="font-serif text-xl text-brown mb-4">¿Te gustaría más información?</p>
        <a
          href="/contacto"
          class="inline-flex items-center px-6 py-3 rounded-full bg-terracotta text-cream text-sm tracking-wide hover:bg-terracotta/90 transition-colors"
        >
          Contactar
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
