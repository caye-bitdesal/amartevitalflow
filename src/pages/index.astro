---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import TestimonialCarousel from "../components/TestimonialCarousel.astro";
import {
  site,
  intro,
  manifesto,
  firstStep,
  services,
  whatIs,
} from "../data/site";
---

<BaseLayout>
  <!-- Hero -->
  <section
    class="relative w-full h-[55vh] lg:h-[65vh] overflow-hidden bg-brown"
    aria-label={site.name}
  >
    <div class="absolute inset-0 grid grid-cols-[minmax(0,0.9fr)_minmax(0,1.7fr)_minmax(0,0.9fr)]">
      <div class="relative min-w-0 overflow-hidden" aria-hidden="true">
        <img
          src="/picture-masage-chat.png"
          alt=""
          class="absolute inset-0 h-full w-full object-cover"
        />
      </div>

      <div class="relative min-w-0 overflow-hidden bg-[#e0d4c0]">
        <div class="relative z-10 flex h-full items-center justify-center px-4 sm:px-6">
          <div class="text-center w-full max-w-3xl py-3 sm:py-4">
            <img
              src="/logo.png"
              alt={site.name}
              class="mx-auto h-40 sm:h-52 lg:h-64 w-auto mb-4 sm:mb-6"
            />
            <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-brown leading-tight mb-3 sm:mb-4">
              {site.heroHeadline}
            </h1>
            <p class="font-serif text-lg sm:text-xl lg:text-[1.4rem] text-brown/80 leading-relaxed mb-5 sm:mb-6 max-w-2xl mx-auto">
              {site.tagline}
            </p>
            <a
              href="/contacto"
              class="inline-flex items-center px-8 py-3.5 rounded-full bg-terracotta text-cream font-medium tracking-wide hover:bg-terracotta/90 transition-colors shadow-sm"
            >
              Contactar
            </a>
          </div>
        </div>
      </div>

      <div class="relative min-w-0 overflow-hidden" aria-hidden="true">
        <img
          src="/consulta-floral.png"
          alt=""
          class="absolute inset-0 h-full w-full object-cover"
        />
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="py-20 lg:py-28 bg-cream-dark/30" id="servicios">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="text-center mb-14">
        <h2 class="font-serif text-3xl lg:text-4xl text-brown mb-4">¿Cómo te puedo acompañar?</h2>
        <p class="text-brown/70 max-w-xl mx-auto">
          Tres caminos para reconectar con tu bienestar: comprender, experimentar y expresar.
        </p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {services.map((service) => <ServiceCard {...service} />)}
      </div>
    </div>
  </section>

  <!-- Manifesto + First step -->
  <section class="py-20 lg:py-28 bg-white">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">
        <div>
          <p class="font-serif text-2xl lg:text-3xl text-brown mb-8 leading-snug">{manifesto.lead}</p>
          <ul class="space-y-1 mb-8 text-center">
            {
              manifesto.items.map((item) => (
                <li class="text-lg text-brown/80 italic leading-snug">{item}</li>
              ))
            }
          </ul>
          {
            manifesto.paragraphs.map((p) => (
              <p class="text-brown/75 leading-relaxed mb-6 last:mb-0 text-justify">{p}</p>
            ))
          }
        </div>

        <div>
          <p class="text-brown/70 mb-2">{firstStep.transition}</p>
          <p class="font-serif text-3xl lg:text-4xl text-terracotta mb-8 leading-snug">{firstStep.highlight}</p>
          <h2 class="font-serif text-2xl lg:text-3xl text-brown mb-6 leading-snug">
            {firstStep.title}
          </h2>
          {
            firstStep.body.split("\n\n").map((p) => (
              <p class="text-brown/75 leading-relaxed mb-4 last:mb-0 text-justify">{p}</p>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- What is -->
  <section class="py-20 lg:py-28">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <h2 class="font-serif text-3xl lg:text-4xl text-brown text-center mb-8">{whatIs.title}</h2>
      <p class="font-serif text-xl text-terracotta text-center leading-relaxed mb-10">
        {whatIs.highlight}
      </p>
      {
        whatIs.paragraphs.map((p) => (
          <p class="text-brown/75 leading-relaxed mb-6 text-justify">{p}</p>
        ))
      }
    </div>
  </section>

  <!-- Intro -->
  <section class="py-20 lg:py-28 bg-white">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div class="space-y-2">
          <p class="font-serif text-xl sm:text-2xl lg:text-[1.75rem] text-brown leading-snug text-justify">
            <span class="text-brown/45" aria-hidden="true">“</span>
            {intro.feelings[0]}
          </p>
          {
            intro.feelings.slice(1, -1).map((line) => (
              <p class="font-serif text-xl sm:text-2xl lg:text-[1.75rem] text-brown leading-snug text-justify pl-4 sm:pl-5">{line}</p>
            ))
          }
          <p class="font-serif text-xl sm:text-2xl lg:text-[1.75rem] text-brown leading-snug text-justify pl-4 sm:pl-5">
            {intro.feelings.at(-1)}
            <span class="text-brown/45" aria-hidden="true">”</span>
          </p>
          <p class="text-brown/80 leading-relaxed text-lg pt-6 text-justify">{intro.closing}</p>
        </div>
        <div class="relative aspect-[4/5] rounded-[3rem] overflow-hidden bg-gradient-to-br from-sage/30 to-terracotta/20">
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="text-center p-8">
              <div class="w-24 h-24 mx-auto mb-4 rounded-full bg-cream/80 flex items-center justify-center">
                <svg class="w-12 h-12 text-sage" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M12 3c-1.5 2-4 4.5-4 8a4 4 0 108 0c0-3.5-2.5-6-4-8z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M8 21c0-3 2-5 4-5s4 2 4 5" />
                </svg>
              </div>
              <p class="text-sm text-brown/60">Imagen placeholder</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <TestimonialCarousel />
</BaseLayout>
