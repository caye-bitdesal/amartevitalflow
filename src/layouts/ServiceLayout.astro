---
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props {
  title: string;
  eyebrow: string;
  intro: string;
  sections: ReadonlyArray<{ title: string; body: string }>;
}

const { title, eyebrow, intro, sections } = Astro.props;
---

<BaseLayout title={title}>
  <section class="py-10 lg:py-24">
    <div class="mx-auto max-w-3xl px-6">
      <p class="text-xs font-medium tracking-[0.2em] text-terracotta mb-4 text-center">{eyebrow}</p>
      <h1 class="mb-2 flex items-center justify-center gap-3 sm:gap-4 text-center font-serif text-3xl sm:text-4xl lg:text-5xl text-brown">
        <span
          class="hidden h-px w-16 shrink-0 bg-gradient-to-r from-transparent via-brown/50 to-transparent sm:block sm:w-24"
          aria-hidden="true"
        ></span>
        <span>{title}</span>
        <span
          class="hidden h-px w-16 shrink-0 bg-gradient-to-r from-transparent via-brown/50 to-transparent sm:block sm:w-24"
          aria-hidden="true"
        ></span>
      </h1>
      <p class="text-lg text-brown/80 leading-relaxed mb-12 text-justify">{intro}</p>

      <div class="space-y-10">
        {
          sections.map((section) => (
            <article>
              <h2 class="font-serif text-2xl text-brown mb-3 text-center after:mx-auto after:mt-2 after:block after:h-px after:w-16 after:bg-gradient-to-r after:from-transparent after:via-brown/50 after:to-transparent after:content-['']">{section.title}</h2>
              <p class="text-brown/75 leading-relaxed text-justify">{section.body}</p>
            </article>
          ))
        }
      </div>

      <div class="mt-14 p-8 rounded-3xl bg-cream-dark/50 text-center">
        <p class="font-serif text-xl text-brown mb-4">¿Te gustaría saber más?</p>
        <a
          href="/contacto"
          class="inline-flex items-center px-6 py-3 rounded-full bg-terracotta text-cream text-sm tracking-wide hover:bg-terracotta/90 transition-colors"
        >
          Contactar
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
