---
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props {
  title: string;
  eyebrow: string;
  intro: string;
  sections: ReadonlyArray<{ title: string; body: string }>;
}

const { title, eyebrow, intro, sections } = Astro.props;
---

<BaseLayout title={title}>
  <section class="py-16 lg:py-24">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <p class="text-xs font-medium tracking-[0.2em] text-terracotta mb-4">{eyebrow}</p>
      <h1 class="font-serif text-4xl lg:text-5xl text-brown mb-6">{title}</h1>
      <p class="text-lg text-brown/80 leading-relaxed mb-12">{intro}</p>

      <div class="space-y-10">
        {
          sections.map((section) => (
            <article>
              <h2 class="font-serif text-2xl text-brown mb-4">{section.title}</h2>
              <p class="text-brown/75 leading-relaxed">{section.body}</p>
            </article>
          ))
        }
      </div>

      <div class="mt-14 p-8 rounded-3xl bg-cream-dark/50 text-center">
        <p class="font-serif text-xl text-brown mb-4">¿Te gustaría saber más?</p>
        <a
          href="/contacto"
          class="inline-flex items-center px-6 py-3 rounded-full bg-terracotta text-cream text-sm tracking-wide hover:bg-terracotta/90 transition-colors"
        >
          Reserva una sesión
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
