---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  href: string;
}

const { eyebrow, title, description, href } = Astro.props;
---

<article class="group flex flex-col bg-white rounded-3xl p-8 shadow-sm border border-cream-dark/50 hover:shadow-md hover:border-sage/30 transition-all duration-300">
  <p class="text-xs font-medium tracking-[0.2em] text-terracotta mb-3">{eyebrow}</p>
  <h3 class="font-serif text-2xl text-brown mb-4">{title}</h3>
  <p class="text-brown/75 leading-relaxed flex-1 mb-6">{description}</p>
  <a
    href={href}
    class="inline-flex self-start items-center px-5 py-2 rounded-full bg-sage text-cream text-sm tracking-wide hover:bg-sage/90 transition-colors"
  >
    Saber más
  </a>
</article>
