---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  href: string;
}

const { eyebrow, title, description, href } = Astro.props;
---

<article
  class="flex flex-col bg-white rounded-3xl p-5 lg:p-8 shadow-sm border border-cream-dark/50 hover:shadow-md hover:border-sage/30 transition-all duration-300"
>
  <p class="text-xs font-medium tracking-[0.2em] text-terracotta mb-3">{eyebrow}</p>
  <div class="mb-1 flex items-start justify-between gap-3 lg:mb-4">
    <h3 class="min-w-0 font-serif text-2xl text-brown">{title}</h3>
    <a
      href={href}
      class="lg:hidden shrink-0 inline-flex items-center px-4 py-1.5 rounded-full bg-sage text-cream text-sm tracking-wide hover:bg-sage/90 transition-colors"
    >
      Saber más
    </a>
  </div>
  <details class="lg:hidden mb-2 open:[&_svg]:rotate-180">
    <summary
      class="inline-flex cursor-pointer list-none items-center gap-1 text-sm font-medium text-brown [&::-webkit-details-marker]:hidden"
    >
      Descripción
      <svg
        class="h-4 w-4 shrink-0 transition-transform"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7" />
      </svg>
    </summary>
    <p class="mt-3 text-justify leading-relaxed text-brown/75">{description}</p>
  </details>
  <p class="mb-6 hidden flex-1 text-justify leading-relaxed text-brown/75 lg:block">{description}</p>
  <a
    href={href}
    class="mt-auto hidden lg:inline-flex self-center items-center px-5 py-2 rounded-full bg-sage text-cream text-sm tracking-wide hover:bg-sage/90 transition-colors"
  >
    Saber más
  </a>
</article>
