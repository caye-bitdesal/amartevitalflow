---
import { testimonials } from "../data/site";
---

<section class="py-20 lg:py-28 bg-cream-dark/40" aria-label="Testimonios">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <h2 class="font-serif text-3xl lg:text-4xl text-brown text-center mb-12">
      Lo que dicen quienes me acompañan
    </h2>

    <div class="relative max-w-3xl mx-auto">
      <div id="testimonial-track" class="overflow-hidden rounded-3xl">
        <div id="testimonial-slides" class="flex transition-transform duration-500 ease-out">
          {
            testimonials.map((item) => (
              <blockquote class="w-full shrink-0 px-8 py-12 lg:px-16 lg:py-16 bg-white text-center">
                <p class="font-serif text-xl lg:text-2xl text-brown leading-relaxed italic mb-8">
                  "{item.quote}"
                </p>
                <footer>
                  <cite class="not-italic">
                    <span class="block font-medium text-brown">{item.author}</span>
                    <span class="block text-sm text-brown/60 mt-1">{item.context}</span>
                  </cite>
                </footer>
              </blockquote>
            ))
          }
        </div>
      </div>

      <div class="flex items-center justify-center gap-4 mt-8">
        <button
          type="button"
          id="prev-testimonial"
          class="p-2 rounded-full border border-brown/20 text-brown hover:bg-white transition-colors"
          aria-label="Testimonio anterior"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        <div id="testimonial-dots" class="flex gap-2">
          {
            testimonials.map((_, i) => (
              <button
                type="button"
                data-index={i}
                class="testimonial-dot w-2 h-2 rounded-full bg-brown/20 transition-colors"
                aria-label={`Ir al testimonio ${i + 1}`}
              />
            ))
          }
        </div>

        <button
          type="button"
          id="next-testimonial"
          class="p-2 rounded-full border border-brown/20 text-brown hover:bg-white transition-colors"
          aria-label="Siguiente testimonio"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  const slides = document.getElementById("testimonial-slides");
  const dots = document.querySelectorAll<HTMLButtonElement>(".testimonial-dot");
  const total = dots.length;
  let current = 0;

  function goTo(index: number) {
    current = (index + total) % total;
    slides!.style.transform = `translateX(-${current * 100}%)`;
    dots.forEach((dot, i) => {
      dot.classList.toggle("bg-terracotta", i === current);
      dot.classList.toggle("bg-brown/20", i !== current);
    });
  }

  document.getElementById("prev-testimonial")?.addEventListener("click", () => goTo(current - 1));
  document.getElementById("next-testimonial")?.addEventListener("click", () => goTo(current + 1));
  dots.forEach((dot) => {
    dot.addEventListener("click", () => goTo(Number(dot.dataset.index)));
  });

  goTo(0);
</script>
